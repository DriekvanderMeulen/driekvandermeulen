{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"workspaces": {
		".": {
			"entry": ["package.json", "turbo.json"]
		},
		"apps/web": {
			"entry": [
				"app/**/*.{ts,tsx}",
				"lib/**/*.ts"
			],
			"ignore": ["app/globals.css", "app/layout.tsx", "app/page.tsx"]
		},
		"packages/eslint-config": {
			"entry": ["*.js"]
		},
		"packages/typescript-config": {
			"entry": ["*.json"],
			"ignoreDependencies": ["next"]
		}
	},
	"ignore": [
		"**/*.d.ts",
		"**/node_modules/**",
		"**/.next/**",
		"**/dist/**",
		"**/build/**",
		"**/*.config.js",
		"**/*.config.ts",
		"**/drizzle/**",
		"**/test-results/**",
		"**/public/**",
		"**/coverage/**",
		"**/.turbo/**",
		"**/out/**",
		"**/.vercel/**",
		"**/packages/ui/**"
	],
	"ignoreDependencies": [],
	"ignoreBinaries": ["jq"]
}
